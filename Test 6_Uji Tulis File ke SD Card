#include "FS.h"
#include "SD_MMC.h"

void setup()
{
  Serial.begin(115200);

  if(!SD_MMC.begin("/sdcard", true))
  {
    Serial.println("SD FAIL");
    return;
  }

  Serial.println("SD OK");

  File file = SD_MMC.open("/test.txt", FILE_WRITE);

  if(!file)
  {
    Serial.println("Open FAIL");
    return;
  }

  file.println("RHYX M21-45 TEST");
  file.close();

  Serial.println("WRITE OK");
}

void loop()
{
}
