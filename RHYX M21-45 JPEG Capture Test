/*
 * RHYX M21-45 Camera Test
 * RGB565 -> JPEG -> SD Card
 * ESP32-CAM AI Thinker
 */

#include "esp_camera.h"
#include "img_converters.h"
#include "FS.h"
#include "SD_MMC.h"

//====================================================
// AI Thinker ESP32-CAM Pin Definition
//====================================================

#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0

#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27

#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5

#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

//====================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("================================");
  Serial.println(" RHYX M21-45 JPEG Capture Test");
  Serial.println("================================");

  //--------------------------------------------------
  // SD CARD
  //--------------------------------------------------

  if (!SD_MMC.begin("/sdcard", true))
  {
    Serial.println("SD Card Mount Failed");
    return;
  }

  if (SD_MMC.cardType() == CARD_NONE)
  {
    Serial.println("No SD Card");
    return;
  }

  Serial.println("SD Card OK");

  Serial.printf("Card Size : %llu MB\n",
                SD_MMC.cardSize() / (1024 * 1024));

  //--------------------------------------------------
  // CAMERA
  //--------------------------------------------------

  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk  = XCLK_GPIO_NUM;
  config.pin_pclk  = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href  = HREF_GPIO_NUM;

  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;

  config.pin_pwdn  = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;

  // RHYX M21-45 terbukti support RGB565
  config.pixel_format = PIXFORMAT_RGB565;

  // Bisa diganti VGA setelah test berhasil
  config.frame_size = FRAMESIZE_QVGA;

  config.jpeg_quality = 12;
  config.fb_count = 1;

  esp_err_t err = esp_camera_init(&config);

  if (err != ESP_OK)
  {
    Serial.printf("Camera Init Failed : 0x%x\n", err);
    return;
  }

  Serial.println("Camera Initialized");

  sensor_t *s = esp_camera_sensor_get();

  Serial.printf("PID : 0x%02X\n", s->id.PID);

  Serial.println("--------------------------------");
}

void loop()
{
  Serial.println("Capturing...");

  camera_fb_t *fb = esp_camera_fb_get();

  if (!fb)
  {
    Serial.println("Capture Failed");
    delay(5000);
    return;
  }

  Serial.println("Capture Success");

  Serial.printf("Width  : %d\n", fb->width);
  Serial.printf("Height : %d\n", fb->height);
  Serial.printf("Length : %d bytes\n", fb->len);

  //--------------------------------------------------
  // RGB565 -> JPEG
  //--------------------------------------------------

  uint8_t *jpg_buf = NULL;
  size_t jpg_len = 0;

  bool jpeg_ok = fmt2jpg(
                    fb->buf,
                    fb->len,
                    fb->width,
                    fb->height,
                    PIXFORMAT_RGB565,
                    80,            // JPEG Quality
                    &jpg_buf,
                    &jpg_len);

  if (!jpeg_ok)
  {
    Serial.println("JPEG Conversion Failed");

    esp_camera_fb_return(fb);

    while (true)
    {
      delay(1000);
    }
  }

  Serial.println("JPEG Conversion Success");

  Serial.printf("JPEG Size : %u bytes\n",
                (unsigned int)jpg_len);

  //--------------------------------------------------
  // SAVE JPEG
  //--------------------------------------------------

  File file = SD_MMC.open("/capture.jpg", FILE_WRITE);

  if (!file)
  {
    Serial.println("File Open Failed");
  }
  else
  {
    size_t written = file.write(jpg_buf, jpg_len);

    file.close();

    Serial.println("JPEG Saved");

    Serial.printf("Written : %u bytes\n",
                  (unsigned int)written);
  }

  //--------------------------------------------------
  // RELEASE MEMORY
  //--------------------------------------------------

  free(jpg_buf);

  esp_camera_fb_return(fb);

  Serial.println("--------------------------------");
  Serial.println("DONE");

  while (true)
  {
    delay(1000);
  }
}
